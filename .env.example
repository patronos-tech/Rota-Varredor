# ROTA VARREDOR - Environment Configuration
# Copy this file to .env and fill with your values

# Backend API
BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000

# Database
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=rota-varredor

# GPS
GPS_ENABLED=true
GPS_UPDATE_INTERVAL=5000
GPS_ACCURACY_THRESHOLD=20

# Maps
MAPS_PROVIDER=demo
# For future integration:
# GOOGLE_MAPS_API_KEY=your_key_here
# MAPBOX_API_KEY=your_key_here

# Mode
APP_MODE=demo
# demo = uses simulated data and GPS
# production = uses real data

# Demo Settings
DEMO_SECTOR_ID=demo-itaquera-001
DEMO_ENABLE_GPS_SIMULATION=true

# Security
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRATION=7d

# Logging
LOG_LEVEL=info
